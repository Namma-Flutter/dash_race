# Copy to `.env` and fill in. Used by docker-compose only.
# Secrets that Nakama itself reads live in local.yml (see local.yml.example).

# Postgres password — MUST match the password inside local.yml -> database.address
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Image pins (override if you need a specific Nakama / Postgres version).
# Both images publish arm64 tags, so these work unchanged on a Raspberry Pi.
NAKAMA_IMAGE=heroiclabs/nakama:3.24.0
POSTGRES_IMAGE=postgres:16-alpine

# Only needed when running with `--profile tls` (Caddy). Point DNS at this box.
DASHRACE_DOMAIN=xxx.example.com
DASHRACE_CONSOLE_DOMAIN=xxx.xxx.example.com
